# Local edge-function secrets for the shared dev backend (scripts/local-backend.sh).
# Copy to supabase/functions/.env in the main checkout; worktrees symlink to it.
# Never put a prod key, endpoint or bucket name here.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the local edge runtime.

# Vertex AI: service account key file of the dev GCP project, pasted whole on one line.
GOOGLE_SERVICE_ACCOUNT=
VERTEX_LOCATION=global
CHAT_MODEL=gemini-3.6-flash
ANALYSIS_MODEL=gemini-3.6-flash
TRYON_MODEL=gemini-nano-banana-2.1
TRYON_MODEL_FALLBACK=gemini-3-pro-image
TRYON_MODEL_EXPERIMENTAL=gemini-3-pro-image
VIDEO_MODEL=gemini-omni-1.1-flash-preview
VIDEO_MODEL_EXPERIMENTAL=veo-3.1-fast-generate-001

# R2 is emulated by SeaweedFS (scripts/local-backend/compose.yaml); these values are fixed.
R2_ACCESS_KEY_ID=tryzeon-dev
R2_SECRET_ACCESS_KEY=tryzeon-dev-secret
R2_ENDPOINT=http://host.docker.internal:8333
R2_PUBLIC_IMAGES_BUCKET_NAME=tryzeon-public-images
R2_TRYON_IMAGES_BUCKET_NAME=tryzeon-tryon-images
R2_TRYON_VIDEOS_BUCKET_NAME=tryzeon-tryon-videos
R2_PUBLIC_IMAGES_BASE_URL=http://host.docker.internal:8333/tryzeon-public-images

# Upstash Redis is emulated by serverless-redis-http; these values are fixed.
UPSTASH_REDIS_REST_URL=http://host.docker.internal:8079
UPSTASH_REDIS_REST_TOKEN=tryzeon-dev-redis

# RevenueCat: secret API key of the dev RevenueCat project. The webhook never
# reaches the local backend, so its secret only has to be non-empty.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=local-only

# LINE is not wired to the local backend. Leave these empty so nothing can push to a real user.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LIFF_URL=
